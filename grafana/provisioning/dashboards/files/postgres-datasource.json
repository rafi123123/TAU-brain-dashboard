                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    source AS \"Source\",\n    to_char(start_time AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI:SS') || ' UTC' AS \"Start Time\",\n    to_char(stop_time AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI:SS') || ' UTC' AS \"Stop Time\",\n    status AS \"Status\",\n    error_msg AS \"Error Message\"\nFROM (\n    SELECT DISTINCT ON (source)\n        source,\n        start_time,\n        stop_time,\n        status,\n        error_msg\n    FROM smb_scraping_jobs\n    ORDER BY source, start_time DESC\n) t\nORDER BY source;"
