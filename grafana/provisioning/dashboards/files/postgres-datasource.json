                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "-- SELECT\n--   src.source :: text AS metric,\n--   (\n--     SELECT\n--       COUNT(*)\n--     FROM\n--       scan_data_history s\n--     WHERE\n--       s.source :: text IN (${scans_from:singlequote})\n--       AND NOT EXISTS (\n--         SELECT\n--           1\n--         FROM\n--           scan_data_history g\n--         WHERE\n--           g.scan_time = s.scan_time\n--           AND g.source = src.source\n--       )\n--   ) AS value\n-- FROM\n--   unnest(enum_range(NULL :: source)) AS src(source)\n-- WHERE\n--   src.source :: text NOT IN (${scans_from:singlequote})\n--   AND src.source :: text <> 'ORCHESTRATORE'\n-- ORDER BY\n--   src.source\nSELECT\n  src.source :: text AS metric,\n  (\n    SELECT\n      COUNT(*)\n    FROM\n      scan_data_history s\n    WHERE\n      s.source :: text IN (${scans_from:singlequote})\n      AND src.source :: text NOT IN (${scans_from:singlequote})\n      AND NOT EXISTS (\n        SELECT\n          1\n        FROM\n          scan_data_history g\n        WHERE\n          g.scan_time = s.scan_time\n          AND g.source = src.source\n      )\n  ) AS value\nFROM\n  unnest(enum_range(NULL :: source)) AS src(source)\nWHERE\n  src.source :: text <> 'ORCHESTRATORE'\nORDER BY\n  src.source",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
