{
  "uid": "missing-folders",
  "title": "Missing Folders",
  "tags": ["smb", "google-sheets"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["30m", "1h"]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Missing folders",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "missing-folders-api" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "missing-folders-api" },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "http://api:8000/missing-folders",
          "url_options": { "method": "GET", "data": "" },
          "root_selector": "",
          "columns": [{ "selector": "missing_count", "text": "Missing", "type": "number" }],
          "filters": []
        }
      ]
    },
    {
