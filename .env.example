# SMB share holding the scan folders
NAS_HOST=
NAS_USERNAME=
NAS_PASSWORD=
NAS_SHARE=
# Optional subdirectory inside the share to audit instead of its root
NAS_PATH=

# Google Sheet providing the expected scan identifiers
